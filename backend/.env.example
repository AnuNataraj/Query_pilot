# Copy this file to .env and pick ONE LLM option below.
# After changing .env, restart the backend (Ctrl+C, then python manage.py runserver).

# ---------------------------------------------------------------------------
# Option A: Offline demo (default). No key, no internet. Answers only the
# sample questions. Good as a backup if the interview Wi-Fi fails.
# ---------------------------------------------------------------------------
LLM_PROVIDER=demo

# ---------------------------------------------------------------------------
# Option B: Google Gemini (has a free tier). Get a key at https://aistudio.google.com
# Check AI Studio for current model names if this one is retired.
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-3.6-flash
# LLM_API_KEY=paste-your-key-here

# ---------------------------------------------------------------------------
# Option C: Ollama (free, runs on your laptop, works with no internet).
# Install from https://ollama.com, then run:  ollama pull qwen2.5-coder:7b
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5-coder:7b
# LLM_API_KEY=

# ---------------------------------------------------------------------------
# Option D: OpenAI
# ---------------------------------------------------------------------------
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4.1-mini
# LLM_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Option E: Anthropic Claude
# ---------------------------------------------------------------------------
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-5-5
# LLM_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# Retrieval (RAG). tfidf works offline with no setup.
# For neural embeddings use any OpenAI-compatible /embeddings endpoint, e.g.
# Ollama:  EMBEDDINGS_BACKEND=openai, EMBEDDINGS_BASE_URL=http://localhost:11434/v1,
#          EMBEDDINGS_MODEL=nomic-embed-text   (after: ollama pull nomic-embed-text)
# ---------------------------------------------------------------------------
EMBEDDINGS_BACKEND=tfidf
# EMBEDDINGS_BASE_URL=
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_API_KEY=

# Safety limits
MAX_ROWS=500
QUERY_TIMEOUT_S=5
MAX_SQL_ATTEMPTS=3
